{
  "name": "invoicetrucker",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @invoicetrucker/web dev",
    "dev:api": "dotnet watch --project apps/api/FleetForge.Api",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:web && pnpm api:test",
    "test:web": "pnpm --filter @invoicetrucker/web test",
    "test:e2e": "pnpm --filter @invoicetrucker/web test:e2e",
    "build": "pnpm build:web && pnpm api:build",
    "build:web": "pnpm --filter @invoicetrucker/web build",
    "format": "prettier --write . && dotnet format apps/api/FleetForge.slnx --no-restore",
    "format:check": "prettier --check . && dotnet format apps/api/FleetForge.slnx --no-restore --verify-no-changes",
    "api:restore": "dotnet restore apps/api/FleetForge.slnx",
    "api:build": "dotnet build apps/api/FleetForge.slnx --no-restore",
    "api:test": "dotnet test apps/api/FleetForge.slnx --no-restore"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<=1.1.15": "1.1.16",
      "brace-expansion@>=2.0.0 <2.0.2": "2.0.2",
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  }
}
